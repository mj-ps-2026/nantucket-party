# Database (Neon via Vercel Marketplace)
STORAGE_POSTGRES_URL=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# Admin auth (generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))")
ADMIN_PASSWORD_HASH=

# Session secret (any random string, for cookie encoding. Falls back to ADMIN_PASSWORD_HASH)
SESSION_SECRET=

# Cloudflare Turnstile (anti-spam captcha for the public RSVP + wall forms).
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Set BOTH keys to turn it on; leave them blank and the forms work without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames the captcha is allowed to be solved on.
# Rejects tokens solved elsewhere (e.g. a stolen site key). Leave blank to skip.
# e.g. nantucketparty.com,nantucket-party.vercel.app,localhost
TURNSTILE_ALLOWED_HOSTNAMES=
